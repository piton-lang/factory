use @piton/belay
use @piton/config
use @piton/packaging

from @piton/belay import ClaudeCodeAdapter, OpenCodeAdapter

export piton-config Project:
    root: ./spec
    entry: ./spec/index.pi

    frameworks:
        - {Belay}

    packages:
        - {FactoryPackage}

    dependencies:
        - https://github.com/piton-lang/crux.git

belay-config Belay:
    codeRoot: .

    adapters:
        - {ClaudeCodeAdapter}
        - {OpenCodeAdapter}

piton-package FactoryPackage:
    name: factory
    root: ./spec/factory
